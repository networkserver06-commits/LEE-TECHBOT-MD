# Copy this file to .env and fill in values locally or in your hosting panel.
NODE_ENV=production
BOT_NAME=LEE TECH BOT
BOT_OWNER=LEE TECH
BOT_MODE=private
PREFIX=.
MENU_USER_NAME=
# If empty, the menu uses the linked WhatsApp push name, then the linked number.
TIME_ZONE=Africa/Nairobi
OWNER_NUMBER=
SUPER_OWNER_NUMBER=
AUTH_METHOD=pair
PHONE_NUMBER=
PAIRING_NUMBER=
PAIRING_CODE=
AUTH_DIR=./auth
SESSION_RECOVERY_RESET=false
CHANNEL_LINK=

# Optional AI/media providers
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=700
# Optional: GROQ_SYSTEM_PROMPT=You are a helpful WhatsApp bot.
GIPHY_API_KEY=
TENOR_API_KEY=
TELEGRAM_BOT_TOKEN=
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZ_API_KEY=
FGMODS_API_KEY=

# Runtime controls
COMMAND_RATE_LIMIT=8
COMMAND_RATE_WINDOW_MS=10000
LOG_LEVEL=info
USE_MOBILE=false

# Optional alias accepted by the Groq command
Copy this file to .env and add your own values.
# Never commit real API keys.

# Groq API key. The bot accepts either name; GROQ_API_KEY is preferred.
# Optional alias for users who call the provider Grok.
GROK_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SYSTEM_PROMPT=You are a helpful WhatsApp bot.
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=700


PAIRING_WEB_ENABLED=true

PAIRING_WEB_PORT=

PAIRING_WEB_HOST=0.0.0.0

PAIRING_WEB_TOKEN=

# Allow choosing Website or Terminal pairing at startup. If the host console
# has no usable stdin, the bot automatically falls back to the website.
PAIRING_WEB_ONLY=false

# Set true to force a terminal phone-number prompt when web-only mode is disabled.
PAIRING_TERMINAL_PROMPT=false

# choose asks for Website or Terminal pairing at startup.
PAIRING_INPUT_MODE=choose

GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
