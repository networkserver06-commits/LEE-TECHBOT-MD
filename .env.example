# Copy this file to .env and fill in values locally or in your hosting panel.
NODE_ENV=production
BOT_NAME=LEE TECH BOT
BOT_OWNER=LEE TECH
BOT_MODE=public
PREFIX=.
TIME_ZONE=Africa/Nairobi
OWNER_NUMBER=
SUPER_OWNER_NUMBER=
AUTH_METHOD=pair
PHONE_NUMBER=
PAIRING_NUMBER=
PAIRING_CODE=
AUTH_DIR=./auth
CHANNEL_LINK=

# Optional AI/media providers
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
GIPHY_API_KEY=
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZ_API_KEY=
FGMODS_API_KEY=

# Runtime controls
COMMAND_RATE_LIMIT=8
COMMAND_RATE_WINDOW_MS=10000
LOG_LEVEL=info
USE_MOBILE=false
